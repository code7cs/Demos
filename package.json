{
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:react": "npm run dev --workspace react-lab",
    "dev:angular": "npm run start --workspace angular-lab",
    "format": "prettier --write --no-error-on-unmatched-pattern \"apps/**/*.{ts,tsx,js,json,css,html,md,yml,yaml}\" \"docs/**/*.{md,yml,yaml}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"apps/**/*.{ts,tsx,js,json,css,html,md,yml,yaml}\" \"docs/**/*.{md,yml,yaml}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\""
  },
  "name": "code7cs-engineering-lab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/react-lab",
    "apps/angular-lab"
  ],
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
